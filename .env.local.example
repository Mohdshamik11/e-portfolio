# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this .example file is committed as documentation.
# In production, set the same variables in the Vercel dashboard
# (Project -> Settings -> Environment Variables, Production + Preview).

# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key ("sb_publishable_..."): safe in the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key ("sb_secret_..."): server-only, bypasses RLS. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Storage bucket for project images. Defaults to "project-images"
# if unset. Set this only if your bucket has a different name.
# SUPABASE_STORAGE_BUCKET=project-images

# Password for the /admin area. Use something not tied to public info
# (not your GitHub username, email, etc.) — it is the only admin protection.
ADMIN_PASSWORD=pick-a-strong-password
